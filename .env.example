# --- Supabase (Project Settings -> API) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Never expose to the browser. Used by the chatbot, order creation and invoice routes.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Anthropic (server-only) ---
ANTHROPIC_API_KEY=sk-ant-...
# Optional overrides
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high  (low keeps chat replies fast)
ANTHROPIC_EFFORT=low

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Max customer messages per chat session (abuse guard)
CHAT_MAX_MESSAGES_PER_SESSION=60
