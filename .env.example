# --- Supabase (Project Settings -> API Keys) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (sb_publishable_...) or legacy anon key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key
# Secret key (sb_secret_...) or legacy service_role key. Server-only, never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-secret-key

# --- AI provider: set ONE of these keys (server-only) ---
# Free option: Google Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Paid option: Anthropic Claude API key from https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional: force a provider when both keys are set ("gemini" or "anthropic").
# If unset, Gemini is used when only GEMINI_API_KEY is set; otherwise Claude.
AI_PROVIDER=
# Optional model overrides
GEMINI_MODEL=gemini-3.8-flash
ANTHROPIC_MODEL=claude-opus-5-5
# Claude only: low | medium | high  (low keeps chat replies fast)
ANTHROPIC_EFFORT=low

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Max customer messages per chat session (abuse guard)
CHAT_MAX_MESSAGES_PER_SESSION=60
